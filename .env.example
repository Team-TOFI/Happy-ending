# Local Supabase: npx --yes supabase@2.122.0 start
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# COPA virtual key; keep real keys in .env / Render environment variables.
AI_API_KEY=
AI_BASE_URL=https://copa.codyssey.kr/v1
AI_MODEL=gpt-5.4-mini

# Supabase Auth (public project key; never put a secret/service-role key in the frontend)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Local Supabase Google provider. Fill values from Google Cloud OAuth web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
