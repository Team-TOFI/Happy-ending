# Render environment variables. Supabase Connect > Session pooler (5432).
# Replace the host/user using the project's actual connection string.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
AI_API_KEY=
AI_BASE_URL=https://copa.codyssey.kr/v1
AI_MODEL=gpt-5.4-mini

# Supabase Auth (public project key; never put a secret/service-role key in the frontend)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Configure Google Client ID/Secret in remote Supabase Auth > Providers > Google.
